              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json().data.batches.find(b => b.expiration_status !== \"vencido\" && b.quantity > 0);",
                  "if (b) pm.collectionVariables.set(\"batchId\", b.id);"
                ]
