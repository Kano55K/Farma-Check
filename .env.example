# Variables de entorno del back-end de Farma-Check (todas opcionales; estos son los valores por defecto).
# Rails no lee este archivo automáticamente: exportalas en la terminal antes de `bin/rails server`
# (PowerShell: $env:FRONTEND_ORIGIN="http://localhost:5173").

# Orígenes permitidos por CORS para la API (separados por coma).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Duración del token de la API, en horas.
API_TOKEN_TTL_HOURS=12
