<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200 px-6 py-4">
    <h1 class="text-2xl font-bold text-gray-900">Panel de Control</h1>
    <p class="text-sm text-gray-500 mt-1">Resumen general del inventario</p>
  </div>

  <div class="p-6 space-y-6">

    <!-- KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
        <p class="text-sm text-gray-500 font-medium">Total Productos</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @total_products %></p>
      </div>

      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
        <p class="text-sm text-gray-500 font-medium">Unidades en Stock</p>
        <p class="text-3xl font-bold text-blue-700 mt-1"><%= @total_stock_value || 0 %></p>
      </div>

      <div class="bg-amber-50 p-5 rounded-xl shadow-sm border border-amber-200">
        <p class="text-sm text-amber-700 font-medium">Vencen en 30 días</p>
        <p class="text-3xl font-bold text-amber-800 mt-1"><%= @expiring_critical.count %></p>
      </div>

      <div class="bg-red-50 p-5 rounded-xl shadow-sm border border-red-200">
        <p class="text-sm text-red-700