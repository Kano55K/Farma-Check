<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
    <div>
      <p class="text-sm text-gray-400"><%= link_to "← Proveedores", suppliers_path, class: "hover:underline" %></p>
      <h1 class="text-2xl font-bold text-gray-900 mt-1"><%= @supplier.company_name %></h1>
    </div>
    <%= link_to "Editar", edit_supplier_path(@supplier),
        class: "border border-gray-300 text-gray-700 text-sm px-4 py-2 rounded-lg hover:bg-gray-50" %>
  </div>

  <div class="p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 space-y-3">
      <h2 class="font-semibold text-gray-800 border-b pb-2">Datos del Proveedor</h2>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">CUIT</span><span class="font-mono"><%= @supplier.cuit %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Contacto</span><span><%= @supplier.contact_name.presence || "—" %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Teléfono</span><span><%= @supplier.phone.presence || "—" %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Email</span><span><%= @supplier.email.presence || "—" %></span></div>
      </div>
    </div>

    <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="font-semibold text-gray-800">Órdenes de Compra</h2>
      </div>
      <div class="divide-y divide-gray-100">
        <% if @purchase_orders.any? %>
          <% @purchase_orders.each do |order| %>
            <div class="px-5 py-3 flex justify-between items-center">
              <div>
                <p class="text-sm font-medium text-gray-900">Orden #<%= order.id %></p>
                <p class="text-xs text-gray-500"><%= order.created_at.strftime("%d/%m/%Y") %></p>
              </div>
              <span class="text-xs px-2 py-1 rounded-full <%= order.status == 'received' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
                <%= order.status&.humanize %>
              </span>
            </div>
          <% end %>
        <% else %>
          <p class="px-5 py-4 text-sm text-gray-400">Sin órdenes de compra.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>