<%= form_with model: supplier, class: "space-y-5" do |f| %>
  <% if supplier.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <p class="text-red-700 font-medium text-sm"><%= pluralize(supplier.errors.count, "error") %> impidieron guardar:</p>
      <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
        <% supplier.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="md:col-span-2">
      <%= f.label :company_name, "Razón Social *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :company_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm", required: true %>
    </div>
    <div>
      <%= f.label :cuit, "CUIT *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :cuit, placeholder: "XX-XXXXXXXX-X", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono", required: true %>
    </div>
    <div>
      <%= f.label :contact_name, "Nombre de contacto", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :contact_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :phone, "Teléfono", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit supplier.new_record? ? "Crear Proveedor" : "Guardar Cambios",
        class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "Cancelar", suppliers_path, class: "text-sm text-gray-600 hover:underline px-3 py-2" %>
  </div>
<% end %>