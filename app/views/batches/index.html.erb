<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Vencimientos</h1>
      <p class="text-sm text-gray-500 mt-1">Control de lotes por fecha de vencimiento</p>
    </div>
    <%= link_to "＋ Ingresar Lote", new_batch_path,
        class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <!-- Filtros -->
  <div class="bg-white border-b border-gray-100 px-6 py-3 flex gap-3">
    <%= link_to "Todos", batches_path,
        class: "text-sm px-3 py-1.5 rounded-lg #{params[:status].blank? ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "🔴 Críticos (30d)", batches_path(status: "critical"),
        class: "text-sm px-3 py-1.5 rounded-lg #{params[:status] == 'critical' ? 'bg-red-600 text-white' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "🟡 Alerta (90d)", batches_path(status: "warning"),
        class: "text-sm px-3 py-1.5 rounded-lg #{params[:status] == 'warning' ? 'bg-amber-500 text-white' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "Vencidos", batches_path(status: "expired"),
        class: "text-sm px-3 py-1.5 rounded-lg #{params[:status] == 'expired' ? 'bg-gray-800 text-white' : 'bg-gray-100 text-gray-700'}" %>
  </div>

  <div class="p-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Medicamento</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Nº Lote</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Cantidad</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Vencimiento</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Ubicación</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Semáforo</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @batches.any? %>
            <% @batches.each do |batch| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium text-gray-900">
                  <%= link_to batch.product.name, product_path(batch.product), class: "hover:underline text-blue-700" %>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-gray-600"><%= batch.lot_number %></td>
                <td class="px-4 py-3 text-center font-semibold"><%= batch.quantity %></td>
                <td class="px-4 py-3 text-center"><%= batch.expiration_date.strftime("%d/%m/%Y") %></td>
                <td class="px-4 py-3 text-gray-500"><%= batch.location.presence || "—" %></td>
                <td class="px-4 py-3 text-center">
                  <% case batch.expiration_status
                     when :vencido %>
                    <span class="bg-gray-800 text-white text-xs px-2 py-1 rounded-full">⚫ VENCIDO</span>
                  <% when :critico %>
                    <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full">🔴 CRÍTICO</span>
                  <% when :alerta %>
                    <span class="bg-amber-100 text-amber-800 text-xs px-2 py-1 rounded-full">🟡 ALERTA</span>
                  <% else %>
                    <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">🟢 OK</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-center">
                  <div class="flex justify-center gap-2">
                    <%= link_to "Editar", edit_batch_path(batch), class: "text-gray-600 hover:underline text-xs" %>
                    <%= button_to "Eliminar", batch_path(batch), method: :delete,
                        class: "text-red-500 hover:underline text-xs",
                        data: { turbo_confirm: "¿Eliminar este lote?" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-4 py-8 text-center text-gray-400">No hay lotes registrados.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>