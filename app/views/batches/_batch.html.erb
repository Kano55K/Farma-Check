<div id="<%= dom_id batch %>">
  <div>
    <strong>Product:</strong>
    <%= batch.product_id %>
  </div>

  <div>
    <strong>Lot number:</strong>
    <%= batch.lot_number %>
  </div>

  <div>
    <strong>Expiration date:</strong>
    <%= batch.expiration_date %>
  </div>

  <div>
    <strong>Quantity:</strong>
    <%= batch.quantity %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= batch.status %>
  </div>

</div>
