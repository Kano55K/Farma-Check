<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200 px-6 py-4">
    <% if @batch.product_id.present? %>
      <p class="text-sm text-gray-400"><%= link_to "← #{Product.find(@batch.product_id).name}", product_path(@batch.product_id), class: "hover:underline" %></p>
    <% else %>
      <p class="text-sm text-gray-400"><%= link_to "← Inventario", products_path, class: "hover:underline" %></p>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900 mt-1">Ingresar Nuevo Lote</h1>
  </div>
  <div class="p-6 max-w-2xl">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <%= render "form", batch: @batch %>
    </div>
  </div>
</div>