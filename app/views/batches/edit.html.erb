<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200 px-6 py-4">
    <p class="text-sm text-gray-400"><%= link_to "← #{@batch.product.name}", product_path(@batch.product), class: "hover:underline" %></p>
    <h1 class="text-2xl font-bold text-gray-900 mt-1">Editar Lote <span class="font-mono text-blue-600"><%= @batch.lot_number %></span></h1>
  </div>
  <div class="p-6 max-w-2xl">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <%= render "form", batch: @batch %>
    </div>
  </div>
</div>