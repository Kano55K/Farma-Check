<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Órdenes de Compra</h1>
      <p class="text-sm text-gray-500 mt-1">Pedidos a proveedores</p>
    </div>
    <%= link_to "＋ Nueva Orden", new_purchase_order_path,
        class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <div class="p-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">#</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Proveedor</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Productos</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Estado</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Fecha</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @purchase_orders.any? %>
            <% @purchase_orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-mono text-gray-500">#<%= order.id %></td>
                <td class="px-4 py-3 font-medium text-gray-900"><%= order.supplier.company_name %></td>
                <td class="px-4 py-3 text-center text-gray-600"><%= order.purchase_order_items.size %></td>
                <td class="px-4 py-3 text-center">
                  <% color = case order.status
                     when "pending" then "bg-amber-100 text-amber-800"
                     when "sent" then "bg-blue-100 text-blue-800"
                     when "received" then "bg-green-100 text-green-800"
                     when "cancelled" then "bg-gray-100 text-gray-600"
                     end %>
                  <span class="<%= color %> text-xs px-2 py-1 rounded-full">
                    <%= { "pending" => "Pendiente", "sent" => "Enviada", "received" => "Recibida", "cancelled" => "Cancelada" }[order.status] %>
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-500"><%= order.created_at.strftime("%d/%m/%Y") %></td>
                <td class="px-4 py-3 text-center">
                  <div class="flex justify-center gap-2">
                    <%= link_to "Ver", purchase_order_path(order), class: "text-blue-600 hover:underline text-xs" %>
                    <%= link_to "Editar", edit_purchase_order_path(order), class: "text-gray-600 hover:underline text-xs" %>
                    <%= button_to "Eliminar", purchase_order_path(order), method: :delete,
                        class: "text-red-500 hover:underline text-xs",
                        data: { turbo_confirm: "¿Eliminar esta orden?" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-gray-400">No hay órdenes de compra aún.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>