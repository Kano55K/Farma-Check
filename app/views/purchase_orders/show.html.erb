<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
    <div>
      <p class="text-sm text-gray-400"><%= link_to "← Órdenes de Compra", purchase_orders_path, class: "hover:underline" %></p>
      <h1 class="text-2xl font-bold text-gray-900 mt-1">Orden #<%= @purchase_order.id %></h1>
      <p class="text-sm text-gray-500"><%= @purchase_order.supplier.company_name %></p>
    </div>
    <%= link_to "Editar", edit_purchase_order_path(@purchase_order),
        class: "border border-gray-300 text-gray-700 text-sm px-4 py-2 rounded-lg hover:bg-gray-50" %>
  </div>

  <div class="p-6 space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs text-gray-500 uppercase font-semibold">Estado</p>
        <p class="text-lg font-bold mt-1"><%= { "pending" => "Pendiente", "sent" => "Enviada", "received" => "Recibida", "cancelled" => "Cancelada" }[@purchase_order.status] %></p>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs text-gray-500 uppercase font-semibold">Proveedor</p>
        <p class="text-lg font-bold mt-1"><%= @purchase_order.supplier.company_name %></p>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs text-gray-500 uppercase font-semibold">Fecha</p>
        <p class="text-lg font-bold mt-1"><%= @purchase_order.created_at.strftime("%d/%m/%Y") %></p>
      </div>
    </div>

    <% if @purchase_order.notes.present? %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs text-gray-500 uppercase font-semibold mb-2">Notas</p>
        <p class="text-sm text-gray-700"><%= @purchase_order.notes %></p>
      </div>
    <% end %>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="font-semibold text-gray-800">Productos solicitados</h2>
      </div>
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="text-left px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Medicamento</th>
            <th class="text-center px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Cantidad</th>
            <th class="text-center px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Precio unitario</th>
            <th class="text-center px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @items.each do |item| %>
            <tr>
              <td class="px-4 py-3 font-medium text-gray-900"><%= item.product.name %></td>
              <td class="px-4 py-3 text-center"><%= item.quantity %></td>
              <td class="px-4 py-3 text-center"><%= item.unit_price ? "$#{item.unit_price}" : "—" %></td>
              <td class="px-4 py-3 text-center font-semibold">
                <%= item.unit_price ? "$#{(item.quantity * item.unit_price).round(2)}" : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>