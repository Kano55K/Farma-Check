<div class="min-h-screen flex items-center justify-center bg-gray-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-md border border-gray-200">
    <div>
      <h2 class="text-center text-3xl font-extrabold text-gray-900">
        Control de Stock - Farmacia
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        Inicia sesión para acceder al sistema
      </p>
    </div>

<% alert = flash.to_h["alert"] %>
<% notice = flash.to_h["notice"] %>

<% if alert.present? %>
  <div class="bg-red-50 border-l-4 border-red-500 p-4 text-red-700 text-sm">
    <%= alert %>
  </div>
<% end %>

<% if notice.present? %>
  <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-700 text-sm">
    <%= notice %>
  </div>
<% end %>

    <%= form_with(url: session_path, class: "mt-8 space-y-6") do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email_address, "Correo Electrónico", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                placeholder: "admin@farmacia.com",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm" %>
        </div>

        <div>
          <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, required: true, autocomplete: "current-password",
                placeholder: "••••••••",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm" %>
        </div>
      </div>

      <div>
        <%= f.submit "Iniciar Sesión", class: "w-full py-2.5 px-4 rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>