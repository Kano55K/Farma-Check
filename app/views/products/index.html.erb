<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Gestión de Inventario</h1>
      <p class="text-sm text-gray-500 mt-1">Medicamentos registrados en el sistema</p>
    </div>
    <%= link_to "＋ Agregar Medicamento", new_product_path,
        class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <!-- Filtros -->
  <div class="bg-white border-b border-gray-100 px-6 py-3">
    <%= form_with url: products_path, method: :get, local: true, class: "flex flex-wrap gap-3 items-center" do |f| %>
      <%= f.text_field :search, value: params[:search], placeholder: "Buscar por nombre, droga o código...",
          class: "border border-gray-300 rounded-lg px-3 py-1.5 text-sm w-64" %>

      <%= f.select :laboratory, options_for_select([["Todos los laboratorios", ""]] + @laboratories.map { |l| [l, l] }, params[:laboratory]),
          {}, class: "border border-gray-300 rounded-lg px-3 py-1.5 text-sm" %>

      <%= f.select :therapeutic_action, options_for_select([["Todas las acciones", ""]] + @therapeutic_actions.map { |t| [t, t] }, params[:therapeutic_action]),
          {}, class: "border border-gray-300 rounded-lg px-3 py-1.5 text-sm" %>

      <div class="flex gap-2">
        <%= link_to "Todos", products_path, class: "text-sm px-3 py-1.5 rounded-lg #{params[:filter].blank? ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700'}" %>
        <%= link_to "Stock Bajo", products_path(filter: "low_stock"), class: "text-sm px-3 py-1.5 rounded-lg #{params[:filter] == 'low_stock' ? 'bg-amber-500 text-white' : 'bg-gray-100 text-gray-700'}" %>
        <%= link_to "Por Vencer", products_path(filter: "expiring"), class: "text-sm px-3 py-1.5 rounded-lg #{params[:filter] == 'expiring' ? 'bg-red-500 text-white' : 'bg-gray-100 text-gray-700'}" %>
        <%= link_to "Sin Stock", products_path(filter: "out_of_stock"), class: "text-sm px-3 py-1.5 rounded-lg #{params[:filter] == 'out_of_stock' ? 'bg-gray-800 text-white' : 'bg-gray-100 text-gray-700'}" %>
      </div>

      <%= f.submit "Filtrar", class: "bg-gray-700 text-white text-sm px-4 py-1.5 rounded-lg cursor-pointer" %>
    <% end %>
  </div>

  <!-- Tabla -->
  <div class="p-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Código / Barras</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Medicamento / Droga</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Laboratorio</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Presentación</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Stock</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Próx. Vence</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Estado</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @products.any? %>
            <% @products.each do |product| %>
              <%
                total_stock = product.batches.active.sum(:quantity)
                next_batch = product.batches.active.where("expiration_date > ?", Date.today).order(:expiration_date).first
                status = if total_stock == 0
                  :sin_stock
                elsif product.min_stock.present? && total_stock <= product.min_stock
                  :stock_bajo
                elsif next_batch && next_batch.expiration_date <= 30.days.from_now
                  :por_vencer
                elsif next_batch && next_batch.expiration_date <= 90.days.from_now
                  :alerta
                else
                  :ok
                end
              %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-gray-500 font-mono text-xs">
                  <%= product.barcode.presence || product.code.presence || "—" %>
                </td>
                <td class="px-4 py-3">
                  <p class="font-medium text-gray-900"><%= product.name %></p>
                  <p class="text-xs text-gray-400"><%= product.active_ingredient.presence || "—" %></p>
                </td>
                <td class="px-4 py-3 text-gray-700"><%= product.laboratory.presence || "—" %></td>
                <td class="px-4 py-3 text-gray-700"><%= product.presentation.presence || "—" %></td>
                <td class="px-4 py-3 text-center font-semibold text-gray-900"><%= total_stock %> u.</td>
                <td class="px-4 py-3 text-center text-gray-500">
                  <%= next_batch ? next_batch.expiration_date.strftime("%m/%Y") : "—" %>
                </td>
                <td class="px-4 py-3 text-center">
                  <% case status
                     when :sin_stock %>
                    <span class="bg-gray-800 text-white text-xs px-2 py-1 rounded-full">SIN STOCK</span>
                  <% when :stock_bajo %>
                    <span class="bg-amber-100 text-amber-800 text-xs px-2 py-1 rounded-full">STOCK BAJO</span>
                  <% when :por_vencer %>
                    <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full">POR VENCER</span>
                  <% when :alerta %>
                    <span class="bg-yellow-100 text-yellow-800 text-xs px-2 py-1 rounded-full">ALERTA</span>
                  <% else %>
                    <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">OK</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-center">
                  <div class="flex justify-center gap-2">
                    <%= link_to "Ver", product_path(product), class: "text-blue-600 hover:underline text-xs" %>
                    <%= link_to "Editar", edit_product_path(product), class: "text-gray-600 hover:underline text-xs" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-4 py-8 text-center text-gray-400">
                No se encontraron medicamentos con los filtros aplicados.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>