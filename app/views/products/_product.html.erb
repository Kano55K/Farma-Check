<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Active ingredient:</strong>
    <%= product.active_ingredient %>
  </div>

  <div>
    <strong>Code:</strong>
    <%= product.code %>
  </div>

  <div>
    <strong>Prescription required:</strong>
    <%= product.prescription_required %>
  </div>

</div>
