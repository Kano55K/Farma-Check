<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200 px-6 py-4">
    <p class="text-sm text-gray-400"><%= link_to "← Dashboard", dashboard_path, class: "hover:underline" %></p>
    <h1 class="text-2xl font-bold text-gray-900 mt-1">Nuevo Usuario</h1>
  </div>
  <div class="p-6 max-w-lg">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <%= form_with model: @user, url: users_path, class: "space-y-4" do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <ul class="text-sm text-red-600 list-disc list-inside">
              <% @user.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div>
          <%= f.label :email_address, "Email *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email_address, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm", required: true %>
        </div>
        <div>
          <%= f.label :password, "Contrasena *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm", required: true %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar contrasena *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm", required: true %>
        </div>
        <div>
          <%= f.label :role, "Rol *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :role, options_for_select([["Empleado", "employee"], ["Administrador", "admin"]], @user.role), {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
        </div>
        <div class="flex gap-3 pt-2">
          <%= f.submit "Crear Usuario", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2 rounded-lg cursor-pointer" %>
          <%= link_to "Cancelar", dashboard_path, class: "text-sm text-gray-600 hover:underline px-3 py-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
